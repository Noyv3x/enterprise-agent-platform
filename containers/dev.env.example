AGENT_PLATFORM_COMPOSE_PROJECT=agent-platform-dev
AGENT_PLATFORM_DATA_ROOT=/tmp/agent-platform-dev
AGENT_PLATFORM_SECRETS_DIR=/tmp/agent-platform-dev/manager/secrets
AGENT_PLATFORM_MANAGER_CONTROL_DIR=/tmp/agent-platform-dev-runtime/agent-platform-manager
AGENT_PLATFORM_PLATFORM_BIND=127.0.0.1:18080
AGENT_PLATFORM_PUBLIC_BASE_URL=http://127.0.0.1:18080
AGENT_PLATFORM_CORE_NETWORK=agent-platform-dev_core
AGENT_PLATFORM_UID=1000
AGENT_PLATFORM_GID=1000
AGENT_PLATFORM_PLATFORM_IMAGE=agent-platform/platform:dev
AGENT_PLATFORM_AGENT_RUNTIME_IMAGE=agent-platform/agent-runtime:dev
AGENT_PLATFORM_CAMOFOX_IMAGE=agent-platform/camofox:dev
