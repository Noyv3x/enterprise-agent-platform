{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.invalid/schemas/release-manifest.json",
  "title": "Agent Platform release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "source_commit",
    "generated_at",
    "protocol_version",
    "database_schema_version",
    "manager",
    "compose",
    "images"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "channel": { "const": "main" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "protocol_version": { "const": 2 },
    "database_schema_version": { "type": "integer", "minimum": 1 },
    "manager": { "$ref": "#/$defs/manager_release" },
    "compose": { "$ref": "#/$defs/artifact" },
    "images": { "$ref": "#/$defs/images" }
  },
  "$defs": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 10,
      "maxProperties": 10,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "properties": {
        "platform": { "$ref": "#/$defs/image" },
        "agent-runtime": { "$ref": "#/$defs/image" },
        "camofox": { "$ref": "#/$defs/image" },
        "agent-sandbox": { "$ref": "#/$defs/image" },
        "searxng": { "$ref": "#/$defs/image" },
        "firecrawl-api": { "$ref": "#/$defs/image" },
        "firecrawl-playwright": { "$ref": "#/$defs/image" },
        "firecrawl-postgres": { "$ref": "#/$defs/image" },
        "firecrawl-redis": { "$ref": "#/$defs/image" },
        "firecrawl-rabbitmq": { "$ref": "#/$defs/image" }
      },
      "required": [
        "platform",
        "agent-runtime",
        "camofox",
        "agent-sandbox",
        "searxng",
        "firecrawl-api",
        "firecrawl-playwright",
        "firecrawl-postgres",
        "firecrawl-redis",
        "firecrawl-rabbitmq"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "manager_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifacts"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amd64", "arm64"],
          "properties": {
            "amd64": { "$ref": "#/$defs/artifact" },
            "arm64": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    },
    "image": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    }
  }
}
