{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.invalid/contracts/release-transition-challenge.schema.json",
  "title": "Release transition deployment challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transition_id",
    "challenge_id",
    "nonce",
    "receipt_type",
    "deployment_id",
    "key_id",
    "predecessor_generation",
    "candidate_generation",
    "expected_observed_generation",
    "expected_profile_id",
    "expected_capability",
    "expected_status",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "transition_id": { "const": "technical-namespace-v1" },
    "challenge_id": { "type": "string", "pattern": "^challenge_[0-9a-f]{32}$" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "receipt_type": {
      "enum": ["source_owner_ready", "target_handoff_committed"]
    },
    "deployment_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "predecessor_generation": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_generation": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expected_observed_generation": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "expected_profile_id": { "enum": ["ubitech-agent-v1", "agent-platform-v1"] },
    "expected_capability": { "enum": ["source_owner", "target_owner"] },
    "expected_status": { "enum": ["idle", "committed"] },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
