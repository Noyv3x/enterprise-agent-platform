      "AGENTS.md",
      "docs/design/*.md",
      "docs/reference/*.md",
      "docs/operations/*.md",
      "docs/development/*.md",
      "docs/contracts/*.json",
      "docs/domains.json"
    ],
    "document_exclude": []
  },
  "domains": [
