{
  "version": 3,
  "forbidden_top_level_files": [
    "CLAUDE.md"
  ],
  "coverage": {
    "code_include": [
      ".gitignore",
      ".github/**/*.yml",
      ".github/**/*.yaml",
      "manager/go.mod",
      "manager/go.sum",
      "manager/**/*.go",
      "containers/**",
